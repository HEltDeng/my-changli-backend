# Example only. Never commit real secrets or copy this file as-is to Production.
MY_CHANGLI_ENV=production
MY_CHANGLI_DEBUG=false
MY_CHANGLI_HOST=127.0.0.1
MY_CHANGLI_PORT=8787

# Production paths must be absolute and outside the Git checkout.
MY_CHANGLI_DB_PATH=/var/lib/mychangli/database/my-changli.db
MY_CHANGLI_UPLOAD_PATH=/var/lib/mychangli/uploads
MY_CHANGLI_LOG_PATH=/var/log/mychangli/backend.jsonl
MY_CHANGLI_BACKUP_PATH=/var/backups/mychangli

# Replace placeholders outside Git. Do not generate long-lived secrets at startup.
MY_CHANGLI_PHONE_HASH_SECRET=GENERATE_48_RANDOM_BYTES_AND_STORE_OUTSIDE_GIT
MY_CHANGLI_PII_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_AND_STORE_OUTSIDE_GIT

# Nginx is the only trusted reverse proxy. Replace domain placeholders at deploy time.
MY_CHANGLI_ALLOWED_HOSTS=api.<ROOT_DOMAIN>
MY_CHANGLI_ADMIN_ORIGIN=https://api.<ROOT_DOMAIN>
MY_CHANGLI_TRUSTED_PROXY=127.0.0.1

# Bounded single-process production settings for V1 SQLite.
MY_CHANGLI_WAITRESS_THREADS=8
MY_CHANGLI_SQLITE_BUSY_TIMEOUT_MS=10000
MY_CHANGLI_MAX_BODY_BYTES=6291456
MY_CHANGLI_UPLOAD_MAX_BYTES=3145728
MY_CHANGLI_UPLOAD_MAX_PIXELS=20000000

# One-time bootstrap variables. Remove them immediately after bootstrap-production.
MY_CHANGLI_SUPER_ADMIN_USERNAME=YOUR_ONE_TIME_SUPER_ADMIN_USERNAME
MY_CHANGLI_SUPER_ADMIN_PASSWORD=YOUR_ONE_TIME_LONG_RANDOM_PASSWORD

# Development-only legacy convenience; never keep these in a Production env file.
# MY_CHANGLI_ADMIN_USERNAME=YOUR_LOCAL_ADMIN_USERNAME
# MY_CHANGLI_ADMIN_PASSWORD=YOUR_LONG_RANDOM_LOCAL_PASSWORD
