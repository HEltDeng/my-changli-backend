# Example only. Never commit real secrets.
MY_CHANGLI_HOST=127.0.0.1
MY_CHANGLI_PORT=8787
MY_CHANGLI_DB_PATH=data/my-changli.db
# Production-style deployments should set a long random value. Local development
# generates a private value beside the ignored database when this is omitted.
MY_CHANGLI_PHONE_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET_LOCALLY
# Optional local key used to encrypt phone numbers for audited administrator reveal.
# Generate a Fernet key locally; never reuse this placeholder.
MY_CHANGLI_PII_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_LOCALLY
# Optional one-time local administrator bootstrap:
MY_CHANGLI_ADMIN_USERNAME=YOUR_LOCAL_ADMIN_USERNAME
MY_CHANGLI_ADMIN_PASSWORD=YOUR_LONG_RANDOM_LOCAL_PASSWORD
